  "nodes": [
    {
      "parameters": {
        "jsCode": "const now = new Date();\n\nfunction parseSheetDate(value) {\n  if (!value) return null;\n\n  // Google Sheets / Excel serial date\n  if (typeof value === \"number\") {\n    return new Date(\n      Date.UTC(1899, 11, 30) + value * 86400000\n    );\n  }\n\n  // ISO date string\n  const date = new Date(value);\n\n  return isNaN(date.getTime()) ? null : date;\n}\n\nreturn items.map(item => {\n  const invoice = item.json;\n\n  const status = String(invoice.Status || \"\").toLowerCase();\n  const reminderCount = Number(invoice[\"Reminder Count\"] || 0);\n  const reminderStage = String(invoice[\"Reminder Stage\"] || \"\").toLowerCase();\n\n  const nextReminder = parseSheetDate(invoice[\"Next Reminder\"]);\n\n  let decision = \"WAIT\";\n  let reason = \"\";\n\n  // Paid invoices stop immediately\n  if (status === \"paid\") {\n    decision = \"PAID\";\n    reason = \"Invoice has already been paid\";\n  }\n\n  // Already escalated invoices stop permanently\n  else if (reminderStage === \"escalated\") {\n    decision = \"WAIT\";\n    reason = \"Invoice has already been escalated\";\n  }\n\n  // Invalid/missing reminder date\n  else if (!nextReminder) {\n    decision = \"WAIT\";\n    reason = \"No valid next reminder date\";\n  }\n\n  // Reminder date has arrived\n  else if (nextReminder <= now) {\n\n    if (reminderCount >= 3) {\n      decision = \"ESCALATE\";\n      reason = \"Maximum reminder count reached\";\n    } else {\n      decision = \"REMINDER_DUE\";\n      reason = \"Next reminder date has arrived\";\n    }\n  }\n\n  // Reminder date is still in the future\n  else {\n    decision = \"WAIT\";\n    reason = \"Next reminder date has not arrived\";\n  }\n\n  return {\n    json: {\n      ...invoice,\n      Decision: decision,\n      Decision_Reason: reason,\n      Checked_At: now.toISOString()\n    }\n  };\n});"
      },
